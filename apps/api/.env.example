# Environment
NODE_ENV=development

# Server Configuration
PORT=5000
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/athletic-meet-system
MONGODB_TEST_URI=mongodb://localhost:27017/athletic-meet-system-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Organizer Setup (Initial Credentials)
ORGANIZER_USER=organizer
ORGANIZER_PASSWORD=meetdesk2026
ORGANIZER_SETUP_KEY=SETUP2026

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@athleticmeet.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# API Documentation
API_VERSION=1.0.0
API_TITLE=Athletic Meet System API
